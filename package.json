{
  "name": "zenith",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "imports": {
    "#client/*": "./src/client/*",
    "#server/*": "./src/server/*",
    "#shared/*": "./src/shared/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "start": "NODE_ENV=production node zenith serve",
    "dev": "node zenith serve -w",
    "build:client": "node zenith build",
    "build:server": "tsdown",
    "build": "npm-run-all build:client build:server",
    "lint": "eslint",
    "test": "npm-run-all test:unit test:int test:e2e",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:e2e": "playwright test",
    "docker:build-test": "docker build -t zenith-test .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
