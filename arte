#!/usr/bin/env node
import cp from 'child_process';
import path from 'path';
import fs from 'fs';

const bin = 'node';

const userArgs = process.argv.slice(2);

const configArgs = userArgs
    .filter(arg => arg.startsWith('@config:'))
    .map(arg => arg.slice('@config:'.length));

const forwardArgs = userArgs.filter(arg => !arg.startsWith('@config:'));

const env = {
    ZARTE: 'true', ...process.env,
    ZENITH_BASE_PATH: import.meta.dirname,
};

// load persisted config from file if RUNTIME_CONFIG_PATH is set
const runtimeConfigPath = env.RUNTIME_CONFIG_PATH;
let fileEntries = [];

if (runtimeConfigPath && fs.existsSync(runtimeConfigPath)) {
    fileEntries = fs.readFileSync(runtimeConfigPath, 'utf-8')
        .split('\n')
        .map(line => line.trim())
        .filter(Boolean);
}

// merge: file entries as base, command args override by key
const entryMap = new Map();

for (const entry of fileEntries) {
    const key = entry.split('=')[0];
    entryMap.set(key, entry);
}

for (const entry of configArgs) {
    const key = entry.split('=')[0];
    entryMap.set(key, entry);
}

const mergedConfig = Array.from(entryMap.values());

// save merged config back to file
if (runtimeConfigPath && mergedConfig.length > 0) {
    fs.mkdirSync(path.dirname(runtimeConfigPath), { recursive: true });
    fs.writeFileSync(runtimeConfigPath, mergedConfig.join('\n'));
}

if (mergedConfig.length > 0) {
    const existing = env.CONFIG_ARGUMENTS ? env.CONFIG_ARGUMENTS.split(';') : [];
    env.CONFIG_ARGUMENTS = [...existing, ...mergedConfig].join(';');
}

const args = [
    '--no-warnings',
    '--experimental-strip-types',
    path.join(import.meta.dirname, 'server', 'cli.ts'),
    ...forwardArgs,
];

const child = cp.spawn(bin, args, {
    stdio: 'inherit',
    cwd: import.meta.dirname,
    env,
});

function killChild() {
    if (child && !child.killed) {
        child.kill('SIGTERM');
    }
}

process.on('SIGINT', () => {
    killChild();
    process.exit(0);
});

process.on('SIGTERM', () => {
    killChild();
    process.exit(0);
});

process.on('exit', () => {
    killChild();
});
