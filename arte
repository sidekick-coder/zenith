#!/usr/bin/env node
import cp from 'child_process';
import path from 'path';

const bin = 'node';

const userArgs = process.argv.slice(2);

const configArgs = userArgs
    .filter(arg => arg.startsWith('config:'))
    .map(arg => arg.slice('config:'.length));

const forwardArgs = userArgs.filter(arg => !arg.startsWith('config:'));

const env = { ZARTE: 'true', ...process.env };

if (configArgs.length > 0) {
    const existing = env.CONFIG ? env.CONFIG.split(';') : [];
    env.CONFIG = [...existing, ...configArgs].join(';');
}

const args = [
    '--no-warnings',
    '--experimental-strip-types',
    path.join(import.meta.dirname, 'server', 'cli.ts'),
    ...forwardArgs,
];

const child = cp.spawn(bin, args, {
    stdio: 'inherit',
    cwd: import.meta.dirname,
    env,
    // shell: true,
});

function killChild() {
    if (child && !child.killed) {
        child.kill('SIGTERM');
    }
}

process.on('SIGINT', () => {
    killChild();
    process.exit(0);
});

process.on('SIGTERM', () => {
    killChild();
    process.exit(0);
});

process.on('exit', () => {
    killChild();
});
