{
    "files": [],
    "references": [
        {
            "path": "./tsconfig.app.json"
        },
        {
            "path": "./tsconfig.node.json"
        }
    ],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "#app/*": [
                "client/*"
            ],
            "#modules/*": [
                "modules/*"
            ],
            "#services/*": [
                "server/services/*"
            ],
            "#common/*": [
                "common/*"
            ],
            "#utils/*": [
                "server/utils/*"
            ],
        }
    }
}